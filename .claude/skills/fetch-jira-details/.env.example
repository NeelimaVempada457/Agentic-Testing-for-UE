# ─── Required ──────────────────────────────────────────────────────────────────

# Jira base URL (no trailing slash)
# Cloud:  https://your-org.atlassian.net
# Server: https://jira.your-company.com
JIRA_BASE_URL=https://your-org.atlassian.net

# Jira login email (Cloud) or username (Server)
JIRA_EMAIL=you@company.com

# API token (Cloud) — generate at: https://id.atlassian.com/manage-profile/security/api-tokens
# Password (Server) — your Jira login password
JIRA_API_TOKEN=your_api_token_here

# ─── Optional ──────────────────────────────────────────────────────────────────

# Output directory for fetched ticket data (defaults to ./jira-output)
# JIRA_OUTPUT_DIR=./jira-output

# Enable verbose debug logging (true/false)
# DEBUG=false
